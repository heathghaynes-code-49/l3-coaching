<!--
  L3 Coaching — shared blog layout (header / nav / footer / CSS / JS)
  ────────────────────────────────────────────────────────────────
  Single source of truth for every generated blog page (blog.html
  and blog/<slug>.html). Edit THIS file to change the nav, footer,
  fonts, or colors across the whole blog section — no more hunting
  through individual post files.

  index.html and scorecard.html are separate, hand-edited static
  files and are NOT affected by this layout.

  Expects: pageTitle, pageDescription (page <title>/meta — named to
  avoid colliding with each post's own `title`/`excerpt` front
  matter). Content is supplied by whichever template uses
  `layout: base.njk`.
-->
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#E3DAD0" />
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}" />

  <!-- Tailwind -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            bone: '#E3DAD0',
            ink:  '#344960',
            tan:  '#5a7390',
            clay: '#344960',
            sage: '#A8B5A0',
          },
          fontFamily: {
            serif: ['Syne', 'ui-serif', 'Georgia', 'serif'],
            sans:  ['Montserrat', 'ui-sans-serif', 'system-ui', 'sans-serif'],
          },
          letterSpacing: {
            tightish: '-0.02em',
          }
        }
      }
    }
  </script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bone:#E3DAD0;
      --ink:#344960;
      --tan:#5a7390;
      --clay:#344960;
      --sage:#A8B5A0;
    }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bone);
      color: var(--ink);
      font-family: 'Montserrat', system-ui, sans-serif;
      font-weight: 500;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    .font-serif { font-family: 'Syne', Georgia, serif; }
    .display {
      font-family: 'Syne', Georgia, serif;
      font-weight: 600;
      letter-spacing: -0.025em;
      line-height: 1.02;
    }

    .container-x { max-width: 1240px; margin-inline: auto; padding-inline: clamp(1.25rem, 4vw, 2.5rem); }
    .section { padding-block: clamp(5rem, 10vw, 8rem); }

    /* Buttons */
    .btn {
      display:inline-flex; align-items:center; justify-content:center;
      gap:.5rem;
      padding: 0.95rem 1.4rem;
      border-radius: 999px;
      font-weight: 500;
      font-size: 0.95rem;
      letter-spacing: 0.01em;
      transition: transform .2s ease, background .2s ease, color .2s ease, box-shadow .2s ease, border-color .2s ease;
      white-space: nowrap;
    }
    .btn-primary { background: var(--ink); color: var(--bone); }
    .btn-primary:hover { background: var(--tan); transform: translateY(-1px); box-shadow: 0 10px 24px -10px rgba(52,73,96,.55); }
    .btn-tan { background: var(--ink); color: #fff; }
    .btn-tan:hover { background: var(--tan); transform: translateY(-1px); box-shadow: 0 10px 24px -10px rgba(52,73,96,.6); }
    .btn-outline { background: transparent; color: var(--ink); border: 1px solid rgba(52,73,96,.25); }
    .btn-outline:hover { border-color: var(--ink); transform: translateY(-1px); }
    .btn:focus-visible { outline: 3px solid var(--tan); outline-offset: 3px; }

    /* Sticky nav — always solid off-white with dark ink text */
    .nav {
      background: rgba(255,255,255,.95);
      backdrop-filter: blur(10px);
      box-shadow: 0 4px 20px -16px rgba(0,0,0,.25);
      color: var(--ink);
    }
    .nav .nav-link { color: var(--ink); }
    .nav .nav-link:hover { color: var(--clay); }
    .nav-link {
      position: relative;
      padding: .55rem .85rem;
      font-size: .92rem;
      font-weight: 500;
      color: var(--ink);
      border-radius: 999px;
      transition: color .2s ease, background .2s ease;
    }
    .nav-link::after {
      content:""; position:absolute; left:50%; bottom: 6px;
      transform: translateX(-50%);
      width: 0; height: 1px; background: var(--clay);
      transition: width .25s ease;
    }
    .nav-link:hover::after { width: 60%; }
    .nav-link.active { color: var(--clay); }
    .nav-link.active::after { width: 60%; }

    /* L3 brand logos in nav and footer */
    .l3-logo-nav { height: 76px; width: auto; display: block; transition: opacity .25s ease; }
    @media (min-width: 768px) {
      .l3-logo-nav { height: 84px; }
    }
    .l3-logo-nav.light { display: none; }
    .l3-logo-nav.dark { display: block; }
    @media (max-width: 640px) {
      .l3-logo-nav { height: 96px; }
    }
    .l3-logo-footer { height: 90px; width: auto; display: block; }

    /* Hamburger */
    .hamburger { display:none; }
    @media (max-width: 900px) {
      .nav-links { display: none !important; }
      .hamburger { display: inline-flex; }
    }
    .mobile-menu {
      position: fixed; inset: 0;
      background: var(--bone);
      z-index: 95;
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      gap: 1.25rem;
      transform: translateY(-100%);
      transition: transform .4s ease;
    }
    .mobile-menu.open { transform: translateY(0); }

    /* Reveal-on-scroll */
    .reveal { opacity: 0; transform: translateY(20px); transition: opacity .7s ease, transform .7s ease; }
    .reveal.in-view { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) {
      * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
      .reveal { opacity: 1; transform: none; }
    }

    /* Focus rings */
    a:focus-visible, button:focus-visible { outline: 3px solid var(--tan); outline-offset: 3px; border-radius: 6px; }

    /* Blog index cards */
    .post-card {
      background:#fff;
      border: 1px solid rgba(52,73,96,.10);
      border-radius: 20px;
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }
    .post-card:hover { transform: translateY(-4px); box-shadow: 0 20px 40px -24px rgba(28,28,28,.18); border-color: rgba(90,115,144,.4); }
    .post-card img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 14px; margin-bottom: 1.25rem; }
    .post-card .post-date { font-size:.72rem; letter-spacing:.18em; text-transform:uppercase; color: var(--tan); font-weight:700; margin-bottom:.85rem; }
    .post-card h2 { font-family:'Syne', Georgia, serif; font-weight:600; font-size:1.35rem; line-height:1.25; color: var(--ink); margin-bottom:.75rem; }
    .post-card h2 a { color: inherit; }
    .post-card h2 a:hover { color: var(--clay); }
    .post-card .excerpt { color: rgba(28,28,28,.7); font-size:.95rem; line-height:1.65; flex: 1; margin-bottom: 1.5rem; }
    .post-card .read-more { font-weight:600; font-size:.9rem; color: var(--clay); display:inline-flex; align-items:center; gap:.4rem; }
    .post-card .read-more::after { content:"→"; transition: transform .2s ease; }
    .post-card:hover .read-more::after { transform: translateX(3px); }

    /* Post body typography */
    .post-body { max-width: 68ch; margin-inline: auto; }
    .post-body p { margin-bottom: 1.5rem; line-height: 1.75; color: rgba(28,28,28,.85); font-size: 1.05rem; }
    .post-body h2 { font-family:'Syne', Georgia, serif; font-weight:700; font-size: 1.6rem; line-height:1.2; margin: 2.75rem 0 1rem; color: var(--ink); }
    .post-body h3 { font-family:'Syne', Georgia, serif; font-weight:700; font-size: 1.2rem; line-height:1.3; margin: 2rem 0 .75rem; color: var(--ink); }
    .post-body a { color: var(--clay); text-decoration: underline; text-underline-offset: 3px; }
    .post-body ul, .post-body ol { margin: 0 0 1.5rem 1.25rem; }
    .post-body ul { list-style: disc; }
    .post-body ol { list-style: decimal; }
    .post-body li { margin-bottom: .5rem; line-height: 1.7; color: rgba(28,28,28,.85); }
    .post-body blockquote { border-left: 3px solid var(--tan); padding-left: 1.25rem; margin: 2rem 0; font-style: italic; color: var(--ink); }

    /* Featured photo (thematic image) — banner under the title */
    .hero-img { width: 100%; aspect-ratio: 16 / 8; object-fit: cover; border-radius: 20px; box-shadow: 0 30px 60px -32px rgba(28,28,28,.35); margin: 2rem 0 2.5rem; display: block; }
    .photo-credit { font-size: .78rem; color: rgba(28,28,28,.45); margin-top: -1.75rem; margin-bottom: 2.5rem; }

    /* Pull-line — an italic standout sentence for emphasis mid-post */
    .pull-line { font-family:'Syne', Georgia, serif; font-style: italic; font-weight: 500; font-size: 1.3rem; color: var(--ink); margin: 2.25rem 0; padding-left: 1.5rem; border-left: 3px solid rgba(90,115,144,.4); }

    /* Inline tool image — smaller, centered, with an optional caption */
    .tool-img-wrap { margin: 2.5rem auto; max-width: 520px; }
    .tool-img-wrap img { width: 100%; border-radius: 14px; border: 1px solid rgba(52,73,96,.15); box-shadow: 0 20px 40px -28px rgba(28,28,28,.3); display: block; }
    .tool-img-wrap .caption { text-align: center; font-size: .8rem; color: rgba(28,28,28,.5); font-style: italic; margin-top: .6rem; }

    /* Prev/next post pager */
    .post-pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .post-pager-link { display: block; padding: 1.25rem 1.5rem; border: 1px solid rgba(52,73,96,.14); border-radius: 14px; transition: border-color .2s ease, transform .2s ease; text-decoration: none; }
    .post-pager-link:hover { border-color: var(--tan); transform: translateY(-2px); }
    .post-pager-newer { text-align: right; }
    .post-pager-label { display: block; font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--tan); font-weight: 700; margin-bottom: .5rem; }
    .post-pager-title { display: block; font-family: 'Syne', Georgia, serif; font-weight: 600; font-size: 1rem; line-height: 1.3; color: var(--ink); }
    @media (max-width: 640px) {
      .post-pager { grid-template-columns: 1fr; }
      .post-pager-newer { text-align: left; }
    }
  </style>
</head>
<body>

  <!-- ───── NAV (same as index.html; links point back to homepage sections) ───── -->
  <header id="nav" class="nav fixed top-0 inset-x-0 z-50 text-ink">
    <div class="container-x flex items-center justify-between h-20 md:h-24">
      <a href="/index.html#top" class="flex items-center" aria-label="L3 Coaching home">
        <img class="l3-logo-nav light" src="/2026 L3 Logos/2026 Full L3 Logo White Text Transparent BG.png" alt="L3 Coaching" />
        <img class="l3-logo-nav dark" src="/2026 L3 Logos/2026 Full L3 Logo Transparent.png" alt="L3 Coaching" />
      </a>

      <nav class="nav-links flex items-center gap-1" aria-label="Primary">
        <a href="/index.html#about" class="nav-link">About</a>
        <a href="/index.html#offers" class="nav-link">Services</a>
        <a href="/index.html#process" class="nav-link">How We Work</a>
        <a href="/blog.html" class="nav-link active">Blog</a>
        <span class="w-px h-5 bg-current opacity-20 mx-2"></span>
        <a href="/index.html#diagnostic" class="btn btn-tan">Free Diagnostic</a>
      </nav>

      <button class="hamburger btn btn-outline" aria-label="Open menu" aria-controls="mobileMenu" aria-expanded="false" id="hamburgerBtn">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </header>

  <!-- Mobile menu -->
  <div id="mobileMenu" class="mobile-menu" aria-hidden="true">
    <button id="mobileClose" class="absolute top-5 right-5 btn btn-outline" aria-label="Close menu">✕</button>
    <a href="/index.html#about" class="font-serif text-3xl" data-mobile>About</a>
    <a href="/index.html#offers" class="font-serif text-3xl" data-mobile>Services</a>
    <a href="/index.html#process" class="font-serif text-3xl" data-mobile>How We Work</a>
    <a href="/blog.html" class="font-serif text-3xl text-clay" data-mobile>Blog</a>
    <a href="/index.html#diagnostic" class="font-serif text-3xl text-clay" data-mobile>Free Diagnostic</a>
  </div>

  <a id="top"></a>

  {{ content | safe }}

  <!-- ───── FOOTER (same as index.html) ───── -->
  <footer class="bg-ink text-bone py-16">
    <div class="container-x grid md:grid-cols-12 gap-10">
      <div class="md:col-span-5">
        <img class="l3-logo-footer mb-4" src="/2026 L3 Logos/2026 Full L3 Logo White Text Transparent BG.png" alt="L3 Coaching" />
        <p class="text-bone/75 max-w-sm leading-relaxed">Liberating leaders that last. A licensed GiANT Worldwide partner.</p>
      </div>

      <div class="md:col-span-4">
        <p class="text-xs uppercase tracking-[.22em] text-bone/55 mb-3">Stay in touch</p>
        <form id="footerForm" class="flex gap-2 max-w-sm">
          <input type="email" required placeholder="you@company.com" aria-label="Email"
                 class="flex-1 bg-transparent border border-bone/25 rounded-full px-4 py-3 text-sm placeholder:text-bone/40 focus:border-tan outline-none" />
          <button class="btn btn-tan" type="submit">Join</button>
        </form>
        <p id="footerFormMsg" class="text-xs text-tan mt-3 hidden">Thanks, we'll be in touch.</p>
      </div>

      <div class="md:col-span-3">
        <p class="text-xs uppercase tracking-[.22em] text-bone/55 mb-3">Connect</p>
        <a href="https://www.linkedin.com" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-bone/85 hover:text-tan transition">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8h4.56v14H.22V8zm7.4 0h4.37v1.92h.06c.61-1.15 2.1-2.36 4.32-2.36 4.62 0 5.47 3.04 5.47 7v7.44h-4.55v-6.6c0-1.58-.03-3.6-2.2-3.6-2.2 0-2.54 1.72-2.54 3.5V22H7.62V8z"/></svg>
          LinkedIn
        </a>
        <p class="mt-6 text-xs text-bone/40">© <span id="year"></span> L3 Coaching. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <script>
    document.getElementById('year').textContent = new Date().getFullYear();

    // Reveal-on-scroll
    const reveals = document.querySelectorAll('.reveal');
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); }
      });
    }, { threshold: 0.12 });
    reveals.forEach(r => io.observe(r));

    // Mobile menu
    const hamb = document.getElementById('hamburgerBtn');
    const mm = document.getElementById('mobileMenu');
    const mmClose = document.getElementById('mobileClose');
    function openMM(){ mm.classList.add('open'); mm.setAttribute('aria-hidden','false'); hamb.setAttribute('aria-expanded','true'); }
    function closeMM(){ mm.classList.remove('open'); mm.setAttribute('aria-hidden','true'); hamb.setAttribute('aria-expanded','false'); }
    hamb.addEventListener('click', openMM);
    mmClose.addEventListener('click', closeMM);
    document.querySelectorAll('[data-mobile]').forEach(a => a.addEventListener('click', closeMM));

    // Footer email form (front-end only, matches index.html behavior)
    document.getElementById('footerForm').addEventListener('submit', (e) => {
      e.preventDefault();
      document.getElementById('footerFormMsg').classList.remove('hidden');
      e.target.reset();
    });
  </script>
</body>
</html>
